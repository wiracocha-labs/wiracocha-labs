---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import LinkButton from '../components/LinkButton.astro'
import ProjectCard from '../components/ProjectCard.astro'
import RoadmapItem from '../components/RoadmapItem.astro'
import HelpBlock from '../components/HelpBlock.astro'
import ImageSquare from '../components/ImageSquare.astro'
import RotatingSphere from '../components/RotatingSphere.astro'
import { nav, footer } from '../data/site'
import { posts, postUrl } from '../data/blog'
import { funding, nf } from '../data/funding'

// TODO: la API de GitHub limita 60 req/h sin token (IP compartida del build en
// Cloudflare puede alcanzarlo). El fallback es 0 — el build nunca falla. Si
// llega a ser problema, usar un GITHUB_TOKEN en env vars de Cloudflare.
const GITHUB_ORG = 'wiracocha-labs'
const repoStats = async (repo: string) => {
  const empty = { stars: 0, forks: 0, release: null as string | null }
  try {
    const [info, latest] = await Promise.all([
      fetch(`https://api.github.com/repos/${GITHUB_ORG}/${repo}`),
      fetch(`https://api.github.com/repos/${GITHUB_ORG}/${repo}/releases/latest`),
    ])
    if (!info.ok) return empty
    const data = await info.json()
    const release = latest.ok ? ((await latest.json()).tag_name ?? null) : null
    return {
      stars: data.stargazers_count ?? 0,
      forks: data.forks_count ?? 0,
      release,
    }
  } catch {
    return empty
  }
}

const content = {
  meta: {
    title: 'Wiracocha Labs — Open research, built in public',
    description:
      'We research and build decentralized AI, P2P networks, and tools that run on your hardware.',
  },
  hero: {
    title: 'Wiracocha Labs',
    body: "We are building the technology we want to see in the world.\n\nAn internet where artificial intelligence doesn't live in corporate servers — but distributed, accessible, yours. Where a ten-year-old computer is not technological waste. Where access to the future doesn't depend on how much you can pay.\n\nWe are not waiting for someone else to build it.",
    cta_primary: 'See projects',
    cta_secondary: 'How to help',
    cta_tertiary: 'Read the whitepaper',
  },
  problem: {
    title: "AI is concentrating. That's not an accident.",
    body: "Today, using real artificial intelligence requires expensive hardware, constant connectivity, and paying a corporation for every query. The most powerful models live in datacenters that consume the electricity of entire cities. Five-year-old computers are already 'not enough'. The most advanced knowledge of humanity is behind a subscription.\n\nThis is not inevitable. It's an architectural decision.\n\nWhen infrastructure is centralized, whoever controls it decides who gets access, at what price, and under what conditions. The history of the internet already showed us where that leads.\n\nWiracocha Labs researches and builds the alternative: AI models that run on your hardware, networks that have no owner, tools that work even if you don't have the latest laptop.",
  },
  projects: {
    id: 'projects',
    title: 'What we are building',
    link_label: 'View on GitHub',
    items: [
      {
        name: 'Chaka',
        repo: 'chaka',
        description:
          'Research on delta compression between model versions for efficient synchronization between nodes in a decentralized P2P network with modest heterogeneous hardware.',
        status: 'Researching',
        badge_variant: 'action',
        href: 'https://github.com/wiracocha-labs/chaka',
        image: '/chaka.webp',
      },
      {
        name: 'quipu-ipfs',
        repo: 'quipu-ipfs',
        description:
          'Decentralized P2P network in Rust. Generic layer of identity, storage and transport for decentralized apps. First use case: encrypted messaging.',
        status: 'In development',
        badge_variant: 'primary',
        href: 'https://github.com/wiracocha-labs/quipu-ipfs',
        image: '/quipu-ipfs.webp',
      },
      {
        name: 'Yachay',
        repo: 'yachay',
        description:
          "Selects the right local AI model for your hardware and your real task. No downloading what you don't need, no paying for what you don't use.",
        status: 'Released (v0.1.0)',
        badge_variant: 'action',
        href: 'https://github.com/wiracocha-labs/yachay',
        image: '/yachay.webp',
      },
    ],
  },
  roadmap: {
    id: 'roadmap',
    title: 'Where we are going',
    note: 'No dates — verifiable milestones',
    badge_variants: {
      done: 'accent',
      in_progress: 'action',
      planned: 'secondary',
      horizon: 'primary',
    },
    phases: [
      {
        title: 'Phase 0 — Foundations',
        status: 'Done',
        status_key: 'done',
        description:
          'Base architectures for Chaka and quipu-ipfs. First public repos. Yachay MVP released (v0.1.0).',
      },
      {
        title: 'Phase 1 — First deliverables',
        status: 'In progress',
        status_key: 'in_progress',
        description:
          'Chasqui MVP functional. Two quipu-ipfs nodes communicating on local network via mDNS ✓. First delta compression experiments.',
      },
      {
        title: 'Phase 2 — Real network',
        status: 'Planned',
        status_key: 'planned',
        description:
          'quipu-ipfs working between nodes on the real internet. Encrypted messaging as first product. Published research results.',
      },
      {
        title: 'Phase 3 — Platform',
        status: 'Planned',
        status_key: 'planned',
        description:
          'quipu-ipfs as a platform for third-party apps. Chaka integration with the network to distribute models.',
      },
      {
        title: 'Phase 4 — Decentralized AI',
        status: 'Horizon (~10 years)',
        status_key: 'horizon',
        description:
          'An AI model that lives in the network, not in a datacenter. No corporate owner. Accessible from modest hardware.',
      },
    ],
  },
  help: {
    id: 'help',
    title: 'How to be part of this',
    intro:
      'Today, Wiracocha Labs is one person. The whole lab is a Raspberry Pi 3 and a MacBook M1 Pro. Everything that exists was built without funding. What is missing does not fit into two hours a day.',
    primary: [
      {
        title: 'Contribute code',
        description:
          'If you work with Rust, P2P, compression or local AI, the repos are open. Every contribution counts.',
        cta_label: 'See repositories',
        cta_href: 'https://github.com/wiracocha-labs',
        external: true,
      },
      {
        title: 'Donate hardware',
        description:
          'If you have a GPU with 24 GB of VRAM gathering dust (any generation, used is fine) and want it running experiments for this project, write to me. I do not need to buy one: I need compute hours.',
        cta_label: 'Offer a GPU',
        cta_href: 'mailto:wiracochalabs@protonmail.com?subject=GPU%20for%20experiments',
        external: false,
      },
      {
        title: 'Lend compute',
        description:
          'If your machine can run an experiment for a few hours, I send you the script and the result goes into the benchmark with your name in the credits.',
        cta_label: 'Lend my machine',
        cta_href: 'mailto:wiracochalabs@protonmail.com?subject=Compute%20for%20experiments',
        external: false,
      },
    ],
    secondary: [
      {
        title: 'Share',
        description:
          'The cheapest way to help: send this to someone who believes it matters.',
        cta_label: 'Follow on Instagram',
        cta_href: 'https://www.instagram.com/wiracocha_labs/',
        external: true,
      },
      {
        title: 'Hire me',
        description:
          'I work on Rust, backend and decentralized systems. What I invoice funds the research.',
        cta_label: 'See portfolio',
        cta_href: 'https://renzotincopa.xyz/',
        external: true,
      },
    ],
  },
  team: {
    title: 'Who is behind this',
    body: 'Wiracocha Labs is today one person: Renzo Tincopa, a backend developer focused on Rust and decentralized systems, from Peru.\n\nWe are not a Silicon Valley team with venture funding. We are open research, built in public, from a rented room — because the future shouldn\'t belong only to those who already have the resources to build it.',
    cta_label: 'Portfolio',
    cta_href: 'https://renzotincopa.xyz/',
    external: true,
    social: [
      { label: 'GitHub', href: 'https://github.com/TincoNomad' },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/in/tinconomad/' },
    ],
  },
}

const paragraphs = (text: string) => text.split('\n\n').filter(Boolean)
const isValidHref = (href: string) =>
  /^https?:\/\//.test(href) || href.startsWith('mailto:') || href.startsWith('/')

const projectItems = await Promise.all(
  content.projects.items.map(async (item) => ({
    ...item,
    stats: await repoStats(item.repo),
  }))
)

const helpPrimary = content.help.primary.filter((block) => isValidHref(block.cta_href))
const helpSecondary = content.help.secondary.filter((block) => isValidHref(block.cta_href))
const showTeamCta = isValidHref(content.team.cta_href)
const year = new Date().getFullYear()

// Solo los 3 posts más nuevos, del más viejo al más nuevo.
const latestPosts = posts.slice(-3)

// Mediodía UTC: evita que la fecha se corra un día por zona horaria.
const formatDate = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('es-PE', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
---

<Layout title={content.meta.title} description={content.meta.description}>
  <Navbar brand={nav.brand} logo={nav.logo} links={nav.links} />

  <main>
    <section class="relative min-h-screen flex items-center">
      <div class="chasqui-container w-full relative">
        <div class="flex flex-col lg:flex-row items-center lg:items-stretch lg:bg-[url('/chakanabg2.webp')] lg:bg-cover lg:bg-center lg:min-h-[85vh]">
          <div class="w-full lg:w-1/2 z-20 py-12 lg:py-20 flex flex-col justify-center">
            <div class="bg-primary/60 backdrop-blur-[6px] rounded-2xl lg:rounded-l-2xl lg:rounded-r-none p-8 lg:p-10 lg:bg-transparent lg:backdrop-blur-none lg:rounded-none">
              <h1 class="text-5xl lg:text-7xl font-display font-bold text-brand mb-6">
                {content.hero.title}
              </h1>
              <div class="space-y-4 text-xl lg:text-2xl text-text-primary/90 mb-6">
                {paragraphs(content.hero.body).map((p) => <p>{p}</p>)}
              </div>
              <div class="flex flex-col sm:flex-row flex-wrap gap-4">
                <LinkButton href="#projects" variant="primary" class="text-lg lg:text-xl lg:px-8 lg:py-4">
                  {content.hero.cta_primary}
                </LinkButton>
                <LinkButton href="#help" variant="secondary" class="text-lg lg:text-xl lg:px-8 lg:py-4">
                  {content.hero.cta_secondary}
                </LinkButton>
                <LinkButton href={funding.whitepaper} variant="secondary">
                  {content.hero.cta_tertiary}
                </LinkButton>
              </div>
            </div>
          </div>
          <div class="w-full lg:absolute lg:inset-y-0 lg:left-[25%] lg:w-[75%] flex items-center justify-center min-h-[40vh] lg:min-h-0">
            <div class="relative w-64 h-64 sm:w-80 sm:h-80 lg:w-full lg:h-full">
              <img
                src="/chakanabg.webp"
                alt=""
                class="absolute inset-0 w-full h-full object-contain lg:hidden"
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <RotatingSphere class="relative z-10 w-full h-full mx-auto" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="chasqui-container">
        <div class="grid md:grid-cols-[1fr_auto] gap-12 items-center">
          <div class="max-w-3xl">
            <h2 class="text-3xl md:text-4xl font-display font-semibold text-brand mb-6">
              {content.problem.title}
            </h2>
            <div class="space-y-4 text-base md:text-lg text-text-primary/90">
              {paragraphs(content.problem.body).map((p) => <p>{p}</p>)}
            </div>
          </div>
          <ImageSquare src="/problem.webp" alt="Problem" class="w-96 max-w-full mx-auto hidden md:flex" />
        </div>
      </div>
    </section>

    <section id={content.projects.id} class="py-16 md:py-24">
      <div class="chasqui-container">
        <h2 class="text-3xl md:text-4xl font-display font-semibold text-brand mb-10">
          {content.projects.title}
        </h2>
        <div class="card-grid">
          {projectItems.map((project) => (
            <ProjectCard
              name={project.name}
              description={project.description}
              status={project.status}
              badgeVariant={project.badge_variant as 'action' | 'accent' | 'primary' | 'secondary'}
              href={project.href}
              linkLabel={content.projects.link_label}
              image={project.image}
              stars={project.stats.stars}
              forks={project.stats.forks}
              release={project.stats.release}
            />
          ))}
        </div>
      </div>
    </section>

    <section id={content.roadmap.id} class="py-16 md:py-24 bg-primary">
      <div class="chasqui-container">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-10">
          <h2 class="text-3xl md:text-4xl font-display font-semibold text-brand">
            {content.roadmap.title}
          </h2>
          <span class="badge badge-action w-fit">{content.roadmap.note}</span>
        </div>
        <ul class="relative">
          {content.roadmap.phases.map((phase, index) => (
            <RoadmapItem
              phase={phase.title}
              title={phase.title}
              status={phase.status}
              badgeVariant={
                content.roadmap.badge_variants[
                  phase.status_key as keyof typeof content.roadmap.badge_variants
                ] as 'action' | 'accent' | 'primary' | 'secondary'
              }
              description={phase.description}
              isLast={index === content.roadmap.phases.length - 1}
            />
          ))}
        </ul>
      </div>
    </section>

    <section id="research" class="py-16 md:py-24">
      <div class="chasqui-container">
        <h2 class="text-3xl md:text-4xl font-display font-semibold text-brand mb-10">
          Research
        </h2>
        <a
          href={funding.whitepaper}
          class="group block max-w-3xl rounded-2xl border border-brand/20 bg-white/5 p-6 md:p-8 hover:bg-white/10 transition-colors"
        >
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="badge badge-action">Whitepaper 0001</span>
            <span class="text-xs text-text-primary/50">v1.1 · November 2026 · English · CC-BY-SA 4.0</span>
          </div>
          <h3 class="font-display text-xl md:text-2xl font-semibold text-brand mb-3">
            Compressing AI model weights for decentralized networks
          </h3>
          <p class="text-sm md:text-base text-text-primary/80 mb-5">
            Three levels of compression, the state of the art, and two measurements that correct
            our own estimate: lossless compression of an already quantized model yields ~2.5%,
            not the 1.1x–1.5x we assumed.
          </p>
          <span class="text-sm font-semibold text-brand group-hover:underline">Read the paper →</span>
        </a>
      </div>
    </section>

    <section id="blog" class="py-16 md:py-24">
      <div class="chasqui-container">
        <h2 class="text-3xl md:text-4xl font-display font-semibold text-brand mb-10">Blog</h2>
        <div class="card-grid">
          {
            latestPosts.map((post) => (
              <a
                href={postUrl(post.slug)}
                target="_blank"
                rel="noopener"
                class="group flex flex-col overflow-hidden rounded-2xl border border-brand/20 bg-white/5 hover:bg-white/10 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-brand"
              >
                <img
                  src={post.image}
                  alt=""
                  width="640"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="w-full aspect-[16/9] object-cover"
                />
                <div class="flex flex-col flex-1 p-4">
                  <h3 class="sr-only">{post.title}</h3>
                  <p class="text-sm italic text-text-primary/60 mb-2">{post.subtitle}</p>
                  <p class="text-sm text-text-primary/80 line-clamp-5 mb-4">{post.excerpt}</p>
                  <div class="flex items-center justify-between mt-auto">
                    <time datetime={post.date} class="text-xs text-text-primary/50">
                      {formatDate(post.date)}
                    </time>
                    <span
                      class="font-display text-sm font-semibold text-brand group-hover:underline"
                    >
                      Leer →
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section id={content.help.id} class="py-16 md:py-24">
      <div class="chasqui-container">
        <h2 class="text-3xl md:text-4xl font-display font-semibold text-brand mb-4">
          {content.help.title}
        </h2>
        <p class="max-w-3xl text-base md:text-lg text-text-primary/90 mb-10">
          {content.help.intro}
        </p>

        <div class="rounded-2xl border border-brand/25 bg-white/5 p-6 md:p-10 mb-10">
          <p class="text-sm md:text-base text-text-primary/70 mb-8">
            Already shipped, with nobody paying for it: {posts.length} published articles, a CLI with
            binaries for 5 platforms, and a whitepaper with 8 references.
          </p>

          <h3 class="text-2xl md:text-3xl font-display font-semibold text-brand mb-2">
            One month of work costs US${nf(funding.goalUsd)}
          </h3>
          <p class="text-sm text-text-primary/60 mb-6">
            US${funding.dayUsd} per working day, {funding.days} days a month.
          </p>

          <div class="flex flex-wrap gap-2 mb-3" aria-hidden="true">
            {
              Array.from({ length: funding.days }).map((_, index) => (
                <span
                  class={`block w-7 h-7 rounded ${
                    index < funding.fundedDays
                      ? 'bg-brand'
                      : 'bg-brand/10 border border-brand/25'
                  }`}
                />
              ))
            }
          </div>
          <p class="text-sm text-text-primary/70 mb-10">
            {funding.fundedDays} of {funding.days} days funded this month.
          </p>

          <div class="grid md:grid-cols-2 gap-10">
            <div>
              <h4 class="font-display font-semibold text-text-primary/90 mb-4">
                What your contribution buys
              </h4>
              <ul class="divide-y divide-brand/15">
                {
                  funding.tiers.map((tier) => (
                    <li class="flex items-center justify-between gap-4 py-3">
                      <span class="font-display font-semibold text-brand tabular-nums">
                        US${nf(tier.usd)}
                      </span>
                      <span class="text-sm text-text-primary/80 text-right">{tier.label}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <h4 class="font-display font-semibold text-text-primary/90 mb-4">
                What ships in those months
              </h4>
              <ol class="space-y-4">
                {
                  funding.milestones.map((milestone) => (
                    <li class="flex gap-4">
                      <span class="font-display text-sm font-semibold text-brand shrink-0 w-14">
                        {milestone.month}
                      </span>
                      <span class="text-sm text-text-primary/80">{milestone.detail}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>

          <div class="mt-10 pt-8 border-t border-brand/15">
            {
              funding.wallet ? (
                <div>
                  <p class="text-sm text-text-primary/60 mb-2">Donations in {funding.network}</p>
                  <code class="block break-all rounded-lg bg-black/30 px-4 py-3 text-sm text-brand">
                    {funding.wallet}
                  </code>
                  <p class="text-xs text-text-primary/50 mt-2">
                    USDC on Polygon only. Sent on any other network, the funds are lost.
                  </p>
                  <p class="text-xs text-text-primary/50 mt-1">
                    Sending USDT, or from another network? Write to
                    <a href={`mailto:${funding.email}?subject=Donation`} class="text-brand hover:underline">
                      {funding.email}
                    </a>
                    in Spanish or English and we work it out.
                  </p>
                </div>
              ) : (
                <LinkButton
                  href={`mailto:${funding.email}?subject=Contribution%20to%20the%20research`}
                  variant="primary"
                >
                  Arrange a contribution
                </LinkButton>
              )
            }
            <div class="mt-6">
              <LinkButton href={funding.whitepaper} variant="secondary">
                Read the whitepaper
              </LinkButton>
            </div>
            <p class="text-sm text-text-primary/50 mt-4">
              Contributions cover time, not equipment. The project does not depend on this. The speed
              does.
            </p>
          </div>
        </div>

        <div class="card-grid">
          {
            helpPrimary.map((block) => (
              <HelpBlock
                title={block.title}
                description={block.description}
                ctaLabel={block.cta_label}
                ctaHref={block.cta_href}
                external={block.external}
              />
            ))
          }
        </div>

        <div class="card-grid">
          {
            helpSecondary.map((block) => (
              <HelpBlock
                title={block.title}
                description={block.description}
                ctaLabel={block.cta_label}
                ctaHref={block.cta_href}
                external={block.external}
              />
            ))
          }
        </div>

        <p class="mt-10 text-sm text-text-primary/50">
          <strong class="text-text-primary/70">Companies:</strong> sponsor a month of research
          (US$2,000). Whitepaper and technical contact:
          <a href={`mailto:${funding.email}`} class="text-brand hover:underline">
            {funding.email}
          </a>
        </p>
      </div>
    </section>

    <section class="py-16 md:py-24">
      <div class="chasqui-container">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div class="max-w-3xl">
            <h2 class="text-3xl md:text-4xl font-display font-semibold text-brand mb-6">
              {content.team.title}
            </h2>
            <div class="space-y-4 text-base md:text-lg text-text-primary/90 mb-8">
              {paragraphs(content.team.body).map((p) => <p>{p}</p>)}
            </div>
            <div class="flex flex-wrap items-center gap-4">
              {showTeamCta && (
                <LinkButton
                  href={content.team.cta_href}
                  variant="secondary"
                  external={content.team.external}
                >
                  {content.team.cta_label}
                </LinkButton>
              )}
              <div class="flex items-center gap-3">
                {content.team.social.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener"
                    class="text-sm text-brand hover:underline underline-offset-4"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
          <ImageSquare src="/team.webp" alt="Wiracocha Labs" class="w-96 max-w-full mx-auto" />
        </div>
      </div>
    </section>
  </main>

  <Footer
    tagline={footer.tagline}
    license={footer.license}
    year={year}
    links={footer.links}
  />
</Layout>

---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { nav, footer } from '../../data/site'

export async function getStaticPaths() {
  const papers = await getCollection('research')
  return papers.map((paper) => ({ params: { slug: paper.id }, props: { paper } }))
}

const { paper } = Astro.props
const { Content } = await render(paper)
const year = new Date().getFullYear()
---

<Layout title={`${paper.data.title} — Wiracocha Labs`} description={paper.data.title}>
  <Navbar brand={nav.brand} logo={nav.logo} links={nav.links} />

  <main class="chasqui-container max-w-3xl py-16 md:py-24">
    <a href="/research" class="text-sm text-brand hover:underline">← Research</a>

    <p class="mt-8 text-xs uppercase tracking-[0.2em] text-brand">
      Whitepaper {paper.id} · {paper.data.version} · {paper.data.date}
    </p>
    <h1 class="mt-3 font-display text-3xl md:text-5xl font-bold text-text-primary">
      {paper.data.title}
    </h1>
    <p class="mt-4 text-sm text-text-primary/50">
      Also on <a href={paper.data.source} target="_blank" rel="noopener" class="underline">GitHub</a>
      · CC-BY-SA 4.0
    </p>

    <article class="paper mt-12">
      <Content />
    </article>
  </main>

  <Footer tagline={footer.tagline} license={footer.license} year={year} links={footer.links} />
</Layout>

<style is:global>
  /* El HTML de <Content /> no recibe el scope del componente, por eso es global
     y todo cuelga de .paper para no filtrar estilos al resto del sitio. */
  .paper {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text-primary) 86%, transparent);
  }

  .paper > * + * {
    margin-top: 1.25rem;
  }

  .paper h2 {
    margin-top: 3rem;
    font-family: 'Oswald', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--color-brand);
    line-height: 1.25;
  }

  .paper h3 {
    margin-top: 2.25rem;
    font-family: 'Oswald', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .paper strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .paper a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .paper ul,
  .paper ol {
    padding-left: 1.5rem;
  }

  .paper ul {
    list-style: disc;
  }

  .paper ol {
    list-style: decimal;
  }

  .paper li + li {
    margin-top: 0.5rem;
  }

  .paper hr {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--color-brand-20);
  }

  .paper blockquote {
    border-left: 2px solid var(--color-brand-20);
    padding-left: 1rem;
    color: color-mix(in srgb, var(--color-text-primary) 65%, transparent);
  }

  .paper code {
    font-size: 0.9em;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
  }

  .paper pre {
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--color-brand-10);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
  }

  .paper pre code {
    background: none;
    padding: 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .paper table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }

  .paper th,
  .paper td {
    border-bottom: 1px solid var(--color-brand-10);
    padding: 0.6rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .paper th {
    color: var(--color-text-primary);
    font-weight: 600;
    border-bottom-color: var(--color-brand-20);
  }
</style>

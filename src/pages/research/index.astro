---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { nav, footer } from '../../data/site'

const papers = (await getCollection('research')).sort((a, b) => b.id.localeCompare(a.id))
const year = new Date().getFullYear()
---

<Layout
  title="Research — Wiracocha Labs"
  description="Whitepapers from Wiracocha Labs on compressing AI model weights for decentralized networks."
>
  <Navbar brand={nav.brand} logo={nav.logo} links={nav.links} />

  <main class="py-16 md:py-24">
    <div class="chasqui-container">
      <h1 class="font-display text-3xl md:text-4xl font-semibold text-brand mb-4">Research</h1>
      <p class="max-w-3xl text-base md:text-lg text-text-primary/90 mb-12">
        Formal research documents. Every paper is versioned, and the measurements inside them can be
        reproduced with the commands listed there.
      </p>

      <div class="space-y-6">
        {
          papers.map((paper) => (
            <a
              href={`/research/${paper.id}`}
              class="group block max-w-3xl rounded-2xl border border-brand/20 bg-white/5 p-6 md:p-8 hover:bg-white/10 transition-colors"
            >
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class="badge badge-action">Whitepaper {paper.id}</span>
                <span class="text-xs text-text-primary/50">
                  {paper.data.version} · {paper.data.date} · CC-BY-SA 4.0
                </span>
              </div>
              <h2 class="font-display text-xl md:text-2xl font-semibold text-brand mb-3">
                {paper.data.title}
              </h2>
              <span class="text-sm font-semibold text-brand group-hover:underline">Read →</span>
            </a>
          ))
        }
      </div>
    </div>
  </main>

  <Footer tagline={footer.tagline} license={footer.license} year={year} links={footer.links} />
</Layout>

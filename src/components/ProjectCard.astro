---
import LinkButton from './LinkButton.astro'
import ImageSquare from './ImageSquare.astro'

export interface Props {
  name: string
  description: string
  status: string
  badgeVariant: 'action' | 'accent' | 'primary' | 'secondary'
  href: string
  linkLabel: string
  image?: string
  stars?: number
  forks?: number
  release?: string | null
}

const {
  name,
  description,
  status,
  badgeVariant,
  href,
  linkLabel,
  image,
  stars,
  forks,
  release,
} = Astro.props

const badgeClasses: Record<string, string> = {
  action: 'badge-action',
  accent: 'badge-accent',
  primary: 'badge-primary',
  secondary: 'badge-secondary',
}
---

<article class="card h-full flex flex-col">
  <ImageSquare src={image} alt={name} class="w-[307.14px] max-w-full aspect-square mb-4 mx-auto" />
  <div class="flex items-start justify-between gap-4 mb-4">
    <h3 class="card-title">{name}</h3>
    <span class={`badge ${badgeClasses[badgeVariant]}`}>{status}</span>
  </div>
  <p class="card-desc mb-6 flex-1">{description}</p>
  <div class="flex items-center gap-3 mb-4 text-sm text-text-primary/70">
    <span>★ {stars ?? 0}</span>
    <span aria-hidden="true">·</span>
    <span>{forks ?? 0} forks</span>
    {release && (
      <>
        <span aria-hidden="true">·</span>
        <span>{release}</span>
      </>
    )}
  </div>
  <LinkButton href={href} variant="primary" external class="w-full sm:w-auto">
    {linkLabel}
  </LinkButton>
</article>

---
import Layout from '../layouts/Layout.astro'
import Navbar from './Navbar.astro'
import Footer from './Footer.astro'

export interface Props {
  title: string
  description: string
  heading: string
  updated: string
}

const { title, description, heading, updated } = Astro.props

// Duplicado a propósito de `content.nav` / `content.footer` en index.astro: son seis
// strings estáticos y esto evita mover el contenido de la home a un módulo compartido.
const nav = {
  brand: { label: 'Wiracocha Labs', href: '/' },
  logo: { src: '/logo.png', alt: 'Wiracocha Labs logo' },
  links: [
    { label: 'Projects', href: '/#projects' },
    { label: 'Roadmap', href: '/#roadmap' },
    { label: 'How to help', href: '/#help' },
  ],
}

const footer = {
  tagline: 'Wiracocha Labs — Open research, built in public.',
  license: 'AGPL-3.0 — Open source',
  links: [
    { label: 'GitHub', href: 'https://github.com/wiracocha-labs' },
    { label: 'Instagram', href: 'https://www.instagram.com/wiracocha_labs/' },
    { label: 'Privacy', href: '/privacy' },
    { label: 'Terms', href: '/terms' },
  ],
}

const year = new Date().getFullYear()
---

<Layout title={title} description={description}>
  <Navbar brand={nav.brand} logo={nav.logo} links={nav.links} />

  <main class="py-16 md:py-24">
    <div class="chasqui-container">
      <div class="max-w-3xl mx-auto">
        <a
          href="/"
          class="text-sm text-brand hover:underline underline-offset-4 focus:outline-none
            focus:ring-2 focus:ring-brand rounded"
        >
          ← Wiracocha Labs
        </a>
        <h1 class="text-4xl md:text-5xl font-display font-bold text-brand mt-4 mb-4">{heading}</h1>
        <p class="badge badge-action">Last updated: {updated}</p>
        <article class="legal-prose mt-8">
          <slot />
        </article>
      </div>
    </div>
  </main>

  <Footer
    tagline={footer.tagline}
    license={footer.license}
    year={year}
    links={footer.links}
  />
</Layout>

<style is:global>
  /* Solo afecta a las páginas legales; nadie más usa .legal-prose. */
  .legal-prose h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-brand);
    margin: 2rem 0 0.75rem;
  }

  .legal-prose h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 1.25rem 0 0.5rem;
  }

  .legal-prose p {
    color: var(--color-text-primary);
    opacity: 0.9;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .legal-prose ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }

  .legal-prose li {
    color: var(--color-text-primary);
    opacity: 0.9;
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .legal-prose strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .legal-prose a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .legal-prose a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .legal-prose h2 {
      font-size: 1.6rem;
    }
  }
</style>
